<Window x:Class="BluetoothHeadphonesUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dotNet大王" Height="450" Width="800" Background="#f0f0f0">
    <Grid>
        <Grid Width="270" Height="220" VerticalAlignment="Center" HorizontalAlignment="Center">

            <Border Background="#e8e9eb" CornerRadius="70">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" Direction="270" ShadowDepth="10" Opacity="0.37"/>
                </Border.Effect>
            </Border>

            <Border CornerRadius="70" ClipToBounds="True">
                <Grid>
                    <Border Background="#e8e9eb" CornerRadius="70" />

                    <Border CornerRadius="70">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#e0ffffff" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="0.2"/>
                                <GradientStop Color="Transparent" Offset="0.8"/>
                                <GradientStop Color="#36000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Canvas VerticalAlignment="Top" Margin="0,66,0,0">
                <Rectangle Width="270" Height="2" Fill="#b4b2b2"/>
                <Rectangle Width="13" Height="2" Fill="White" Canvas.Left="0"/>
                <Rectangle Width="13" Height="2" Fill="White" Canvas.Right="0"/>
            </Canvas>

            <Border Width="150" Height="20" CornerRadius="10" VerticalAlignment="Top" Margin="0,72,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#d6d6d6" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Ellipse Width="7" Height="7" Fill="#66f66f" VerticalAlignment="Center" Margin="0,15,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="4"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="5" Height="5" Fill="#66f66f" VerticalAlignment="Center" Margin="0,15,0,0"/>

            <TextBlock Text="dotNet大王" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top" 
                       Margin="0,135,0,0"
                       FontSize="16"
                       FontWeight="ExtraBold"
                       Foreground="#36000000"/>
        </Grid>
    </Grid>
</Window>